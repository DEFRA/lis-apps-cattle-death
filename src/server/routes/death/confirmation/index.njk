{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: heading
      }) }}

      <p class="govuk-body">We have received your report of death.</p>

      <h2 class="govuk-heading-m">What happens next</h2>

      <p class="govuk-body">Your records will be updated to reflect the status of the animal.</p>

      {{ govukButton({
        text: "Return to the homepage",
        href: homeHref
      }) }}
    </div>
  </div>
{% endblock %}
