{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "date-picker/macro.njk" import lisDatePicker %}
{% from "form/macro.njk" import lisForm with context %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLinkHref
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l">{{ heading }}</h1>

      {% call lisForm({ action: formAction }) %}
        {{ appAutocomplete({
          id: "earTagNumber",
          name: "earTagNumber",
          classes: "govuk-input--width-20",
          containerClasses: "app-autocomplete--width-20",
          value: values.earTagNumber,
          label: {
            text: "Animal ear tag number",
            classes: "govuk-label--m"
          },
          hint: {
            text: "Start typing all or part of the animal’s ear tag number, for example the last 3 digits or your herd mark"
          },
          errorMessage: fieldErrors.earTagNumber,
          items: earTagItems,
          minLength: 1,
          spellcheck: false
        }) }}

        {{ lisDatePicker({
          id: "dateOfBirth",
          name: "dateOfBirth",
          value: values.dateOfBirth,
          label: {
            text: "Date of birth",
            classes: "govuk-label--m"
          },
          hint: {
            text: "Select from the calendar or enter manually, for example 27/3/2026"
          },
          errorMessage: fieldErrors.dateOfBirth,
          maxDate: maxDate
        }) }}

        {{ lisDatePicker({
          id: "dateOfDeath",
          name: "dateOfDeath",
          value: values.dateOfDeath,
          label: {
            text: "Date of death",
            classes: "govuk-label--m"
          },
          hint: {
            text: "Select from the calendar or enter manually, for example 27/3/2026"
          },
          errorMessage: fieldErrors.dateOfDeath,
          maxDate: maxDate
        }) }}

        {{ govukRadios({
          classes: "govuk-radios--inline",
          idPrefix: "sex",
          name: "sex",
          fieldset: {
            legend: {
              text: "Sex of the animal",
              classes: "govuk-fieldset__legend--m"
            }
          },
          errorMessage: fieldErrors.sex,
          items: [
            { value: "male", text: "Male", checked: values.sex == "male" },
            { value: "female", text: "Female", checked: values.sex == "female" }
          ]
        }) }}

        {{ appAutocomplete({
          id: "breed",
          name: "breed",
          classes: "govuk-input--width-20",
          containerClasses: "app-autocomplete--width-20",
          value: values.breed,
          label: {
            text: "Breed",
            classes: "govuk-label--m"
          },
          hint: {
            text: "Start typing the breed or enter the breed code and select from the list"
          },
          errorMessage: fieldErrors.breed,
          items: breedItems,
          minLength: 1
        }) }}

        {{ govukButton({
          text: "Continue",
          preventDoubleClick: true
        }) }}
      {% endcall %}
    </div>
  </div>
{% endblock %}
