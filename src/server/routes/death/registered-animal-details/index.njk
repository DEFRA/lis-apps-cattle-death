{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "date-picker/macro.njk" import lisDatePicker %}
{% from "form/macro.njk" import lisForm with context %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLinkHref
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l">{{ heading }}</h1>

      {% call lisForm({ action: formAction }) %}
        {{ appAutocomplete({
          id: "earTagNumber",
          name: "earTagNumber",
          classes: "govuk-input--width-20",
          containerClasses: "app-autocomplete--width-20",
          value: values.earTagNumber,
          label: {
            text: "Animal ear tag number",
            classes: "govuk-label--m"
          },
          hint: {
            text: "Start typing the last 6 digits of the ear tag number and select from the list"
          },
          errorMessage: fieldErrors.earTagNumber,
          items: earTagItems,
          minLength: 1,
          spellcheck: false
        }) }}

        {{ lisDatePicker({
          id: "dateOfDeath",
          name: "dateOfDeath",
          value: values.dateOfDeath,
          label: {
            text: "Date of death",
            classes: "govuk-label--m"
          },
          hint: {
            text: "Select from the calendar or enter manually, for example 31/3/2026"
          },
          errorMessage: fieldErrors.dateOfDeath,
          maxDate: maxDateOfDeath
        }) }}

        {{ govukButton({
          text: "Continue",
          preventDoubleClick: true
        }) }}
      {% endcall %}
    </div>
  </div>
{% endblock %}
