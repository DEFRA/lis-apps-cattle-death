{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "form/macro.njk" import lisForm with context %}
{% from "scrollable-pane/macro.njk" import lisScrollablePane %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLinkHref
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <p class="govuk-body">
        Select the animal ear tag number from the list to update the details. The status indicator shows which animals are ready to send.
      </p>

      {% if animals.length %}
        {% set animalRows = [] %}
        {% for animal in animals %}
          {% set earTagHtml %}
            <a class="govuk-link" id="{{ animal.id }}" href="{{ animal.href }}">{{ animal.earTagNumber }}</a>
          {% endset %}
          {% set statusHtml %}
            {% if animal.isReady %}
              {{ govukTag({ text: "Ready to send", classes: "govuk-tag--green" }) }}
            {% else %}
              {{ govukTag({ text: "Incomplete", classes: "govuk-tag--blue" }) }}
            {% endif %}
          {% endset %}
          {% set animalRows = (animalRows.push([
            { html: earTagHtml },
            { html: statusHtml, format: "numeric" }
          ]), animalRows) %}
        {% endfor %}

        {% call lisScrollablePane({ label: "Cattle deaths to report" }) %}
          {{ govukTable({
            attributes: { id: "animals" },
            caption: "Cattle deaths to report",
            captionClasses: "govuk-visually-hidden",
            head: [
              { text: "Tag number" },
              { text: "Status", format: "numeric" }
            ],
            rows: animalRows
          }) }}
        {% endcall %}
      {% else %}
        <p class="govuk-body">No deaths have been recorded.</p>
      {% endif %}

      {% call lisForm({ action: formAction }) %}
        {{ govukRadios({
          classes: "govuk-radios--inline",
          idPrefix: "addAnother",
          name: "addAnother",
          fieldset: {
            legend: {
              text: "Add more animals",
              classes: "govuk-fieldset__legend--m"
            }
          },
          errorMessage: fieldErrors.addAnother,
          items: [
            { value: "yes", text: "Yes", checked: values.addAnother == "yes" },
            { value: "no", text: "No", checked: values.addAnother == "no" }
          ]
        }) }}

        {{ govukButton({
          text: "Continue",
          preventDoubleClick: true
        }) }}
      {% endcall %}
    </div>
  </div>
{% endblock %}
